<!DOCTYPE html>
@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - Car Park Rules Engine</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="wrap">
            <a class="brand" asp-controller="Evaluation" asp-action="Index">Car Park Rules Engine</a>
            <nav class="nav" aria-label="Pages">
                <a class="@(action == "Index" || action == "Evaluate" ? "active" : "")" asp-controller="Evaluation" asp-action="Index">Evaluate a session</a>
                <a class="@(action == "AllResults" ? "active" : "")" asp-controller="Evaluation" asp-action="AllResults">Rules and sessions</a>
            </nav>
        </div>
    </header>

    @RenderBody()

    <footer class="footer">
        <div class="wrap">
            Car Park Rules Engine by Steve Jones &middot;
            <a href="https://github.com/wizzard262/car-park-rules-engine">Code on GitHub</a> &middot;
            <a href="https://www.harriercarrier.com/portfolio.html">Portfolio</a>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
